# ~/.config/fish/config.fish — managed by chezmoi

{{ if eq .chezmoi.os "darwin" -}}
# Homebrew (Apple Silicon or Intel)
if test -x /opt/homebrew/bin/brew
    /opt/homebrew/bin/brew shellenv fish | source
else if test -x /usr/local/bin/brew
    /usr/local/bin/brew shellenv fish | source
end
{{ else if eq .chezmoi.os "linux" -}}
# Homebrew (Linux, if installed)
if test -x /home/linuxbrew/.linuxbrew/bin/brew
    /home/linuxbrew/.linuxbrew/bin/brew shellenv fish | source
end
{{ end -}}

# PATH: ~/.local/bin (Claude Code, chezmoi) then ~/.cargo/bin (rust) — same
# precedence as the zsh/bash configs (local before cargo).
fish_add_path -g $HOME/.local/bin $HOME/.cargo/bin

if status is-interactive
    # Starship prompt
    type -q starship && starship init fish | source

    # 1Password CLI shell plugins (uncomment after `op plugin init`)
    # test -f ~/.config/op/plugins.sh && source ~/.config/op/plugins.sh
end
